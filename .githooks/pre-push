#!/bin/sh

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || branch=""
zero="0000000000000000000000000000000000000000"

while read local_ref local_oid remote_ref remote_oid
do
  case "$remote_ref" in
    refs/heads/main)
      if [ "$branch" != "main" ]; then
        echo "ERROR: main must be pushed from the local main branch" >&2
        exit 1
      fi
      ;;
    refs/heads/*)
      if [ "$local_oid" != "$zero" ]; then
        echo "ERROR: AutoMoney permits only the remote main branch ($remote_ref rejected)" >&2
        exit 1
      fi
      ;;
  esac
done

exit 0
